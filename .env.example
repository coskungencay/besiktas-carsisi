# =============================================================================
# cafe-infra — ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayip doldurun.  cp .env.example .env
# =============================================================================

# --- Zorunlu ----------------------------------------------------------------

# Sitenin genel adresi (sonunda / OLMADAN). SEO, OG ve auth bunu kullanir.
NEXT_PUBLIC_APP_URL=https://ornek-kafe.com

# Better Auth cerez imzalama anahtari. HER MUSTERI ICIN FARKLI olmali.
# Uretmek icin:  openssl rand -base64 32
BETTER_AUTH_SECRET=buraya-rastgele-uzun-bir-anahtar-yazin

# Better Auth'un kendi baseURL'i (genelde NEXT_PUBLIC_APP_URL ile ayni)
BETTER_AUTH_URL=https://ornek-kafe.com

# --- Ilk admin kullanicisi (seed) -------------------------------------------
# Sadece ilk kurulumda kullanilir. Kullanici ilk giriste sifresini
# degistirmek ZORUNDADIR. Kullanici olustuktan sonra bu degerler yok sayilir.
ADMIN_EMAIL=admin@ornek-kafe.com
ADMIN_PASSWORD=ilk-giris-sifresi-degistirilecek
ADMIN_NAME=Yonetici

# --- Veri konumu (Docker'da degistirmeyin) ----------------------------------
DATABASE_PATH=/data/app.db
UPLOADS_DIR=/data/uploads

# --- Tema -------------------------------------------------------------------
# Doldurulursa tema BU imaja sabitlenir ve panelden degistirilemez.
# Bos birakilirsa musteri panelden tema secebilir. Fallback: placeholder
NEXT_PUBLIC_THEME=beyaz-oda

# --- Dil -------------------------------------------------------------------
# Sitenin VARSAYILAN dili. Kapatilamaz; ceviri girilmeyen her alan bu dile duser.
# Desteklenenler: tr | en | es | de | ar
# DIKKAT: NEXT_PUBLIC_* degiskenleri build'e gomulur -> degistirince yeniden deploy.
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# Hangi dillerin ACIK olacagi panelden secilir (/admin/diller).
# Yeni kurulumda sadece varsayilan dil aciktir.

# --- Iletisim formu ---------------------------------------------------------
# Ayni IP'nin saatte gonderebilecegi mesaj sayisi (varsayilan 5)
CONTACT_RATE_LIMIT_PER_HOUR=5

# --- SMTP (opsiyonel) -------------------------------------------------------
# SMTP_HOST ve CONTACT_TO_EMAIL doluysa mesajlar ayrica mail olarak gider.
# Bos birakilirsa mesajlar SADECE panelde gorunur (sorunsuz calisir).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ornek-kafe.com
CONTACT_TO_EMAIL=isletme@ornek-kafe.com

# --- Container davranisi ----------------------------------------------------
# Acilista seed calissin mi? (idempotent; mevcut veriyi ezmez)
RUN_SEED=true
